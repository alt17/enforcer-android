<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bigRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/bigLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/muted"
        android:textSize="14sp"
        android:text="@string/dash" />

    <!-- Один прибор: число тянется на всё свободное место. autoSizeText
         недоступен до API 26, поэтому размер шрифта считается в коде. -->
    <TextView
        android:id="@+id/bigValue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/device"
        android:textStyle="bold"
        android:typeface="monospace"
        android:text="@string/dash" />

    <TextView
        android:id="@+id/bigPeak"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/peak"
        android:typeface="monospace"
        android:text="@string/dash" />

    <!-- Несколько приборов: экран делится поровну, строки достраиваются кодом. -->
    <LinearLayout
        android:id="@+id/bigMulti"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button android:id="@+id/bigZero" style="@style/Btn" android:text="@string/btn_zero" />
        <Button android:id="@+id/bigPeakReset" style="@style/Btn" android:text="@string/btn_peak_reset" />
        <Button android:id="@+id/bigBack" style="@style/Btn" android:text="@string/btn_back" />
    </LinearLayout>
</LinearLayout>
