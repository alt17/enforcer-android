<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Светлая тема намеренно фиксирована: прибором работают на улице,
         на солнце тёмный фон не читается. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="android:windowBackground">@color/screen_bg</item>
    </style>

    <!-- Кнопка ряда. Фиксированная высота, одна строка и отключённый
         textAllCaps: заглавными «ОТКЛЮЧИТЬ» и «СОХРАНИТЬ» не влезали
         в четверть экрана и переносились, отчего ряд шёл вразнобой. -->
    <style name="Btn" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
